# Copy this file to ".env" in the same folder and fill in your own values.

# Your MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <username>, <password>, and the cluster host with your own.
# The database name at the end ("royella") can be anything you like -
# Mongoose/MongoDB creates it automatically the first time data is written.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/royella?retryWrites=true&w=majority

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Vite's dev server defaults to http://localhost:3000 (see vite.config.js).
CORS_ORIGIN=http://localhost:3000
